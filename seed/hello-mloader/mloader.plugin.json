{
  "id": "hello-mloader",
  "name": "Hello Mloader（内置示例）",
  "version": "1.0.0",
  "description": "dsh-mloader 的内置示例插件：演示注册工具、订阅事件、注册清理。可自由修改，码头不会覆盖。",
  "backend": "python",
  "entry": "plugin.py",
  "enabled": true,
  "inject": ["tools"],
  "timeouts": {
    "startupMs": 10000,
    "callMs": 15000
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.d.ts", "src/client/**"]
}

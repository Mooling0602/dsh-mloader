{
  "name": "dsh-mloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-runtime plugin loader for DeepSeek Harness: hosts Python and WebAssembly plugins as capabilities of one Cordis plugin.",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mooling0602/dsh-mloader.git"
  },
  "homepage": "https://github.com/Mooling0602/dsh-mloader#readme",
  "bugs": {
    "url": "https://github.com/Mooling0602/dsh-mloader/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin-loader",
    "python",
    "wasm"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "client.js",
    "locale/*.json",
    "src",
    "!src/**/__pycache__",
    "!src/**/*.pyc",
    "seed",
    "cordis.patch.yml",
    "COPYING",
    "COPYING.LESSER",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "newLine": "lf",
    "rootDir": "src/client",
    "outDir": ".build/client"
  },
  "include": ["src/client/**/*.ts"]
}
